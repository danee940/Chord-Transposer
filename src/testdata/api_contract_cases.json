      "files": [
        {
          "field": "file",
          "filename": "song.docx",
          "content": "C    G    Am   F",
          "raw": false
        }
      ],
      "form": {
        "current_key": "C",
        "target_key": "D",
        "format": "pdf"
      }
    },
    "fields": [
      "file",
      "current_key",
      "target_key",
      "format"
