  {
    "description": "transpose-text returns the transposed text download",
    "endpoint": "/transpose-text",
    "trigger": "submit",
    "request": {
      "files": [
        {
          "field": "file",
          "filename": "hymn.txt",
          "content": "C    G    Am   F\nAmazing grace how sweet",
          "raw": false
        }
      ],
      "form": {
        "current_key": "C",
        "target_key": "D",
        "format": "txt"
      }
    },
    "fields": [
      "current_key",
      "target_key",
      "file",
      "format"
    ],
    "response": {
      "status": 200,
      "content_type": "text/plain; charset=utf-8",
      "headers": {
        "X-Transpose-From": "C",
        "X-Transpose-To": "D",
        "X-Transpose-Changes": "Am-%3EBm%2C%20C-%3ED%2C%20F-%3EG%2C%20G-%3EA",
        "Content-Disposition": "attachment; filename=hymn_D.txt"
      },
      "body_text": "D    A    Bm   G\nAmazing grace how sweet"
    },
    "ui": {
      "heading": "Transposed from C to D",
      "changes": [
        [
          "Am",
          "Bm"
        ],
        [
          "C",
          "D"
        ],
        [
          "F",
          "G"
        ],
        [
          "G",
          "A"
        ]
      ],
      "download": "hymn_D.txt"
    }
  },
