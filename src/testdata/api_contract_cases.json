[
  {
    "description": "detect-key returns the key guess for a .docx upload",
    "endpoint": "/detect-key",
    "trigger": "detect",
    "request": {
      "files": [
        {
          "field": "file",
          "filename": "hymn.docx",
          "content": "D G A7 D\nBm G A7 D",
          "raw": false
        }
      ],
      "form": {}
    },
    "fields": [
      "file"
    ],
    "response": {
      "status": 200,
      "json": {
        "alternate": null,
        "ambiguous": false,
        "chords": 8,
        "distinct": 4,
        "key": "D"
      }
    },
    "ui": {
      "detected": "Detected: D"
    }
  },
  {
    "description": "detect-key rejects a corrupt .docx with an error payload",
    "endpoint": "/detect-key",
    "trigger": "detect",
    "request": {
      "files": [
        {
          "field": "file",
          "filename": "broken.docx",
          "content": "not a real docx",
          "raw": true
        }
      ],
      "form": {}
    },
    "fields": [
      "file"
    ],
    "response": {
      "status": 400,
      "json": {
        "error": "Could not read the file as a valid .docx document."
      }
    },
    "ui": {
      "detection_ignored": true
    }
  },
  {
    "description": "transpose returns the sheet with key-aware headers",
    "endpoint": "/transpose",
    "trigger": "submit",
    "request": {
      "files": [
        {
          "field": "file",
          "filename": "song.docx",
          "content": "C    G    Am   F",
          "raw": false
        }
      ],
      "form": {
        "current_key": "C",
        "target_key": "F#",
        "format": "docx"
      }
    },
    "fields": [
      "file",
      "current_key",
      "target_key",
      "format"
    ],
    "response": {
      "status": 200,
      "content_type": "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "headers": {
        "X-Transpose-From": "C",
        "X-Transpose-To": "F%23",
        "X-Transpose-Changes": "Am-%3ED%23m%2C%20C-%3EF%23%2C%20F-%3EB%2C%20G-%3EC%23",
        "Content-Disposition": "attachment; filename=song_F#.docx"
      }
    },
    "ui": {
      "heading": "Transposed from C to F#",
      "download": "song_F#.docx",
      "preview": "F#   C#   D#m  B",
      "change_rows": [
        "A → D# · Am",
        "C → F#",
        "F → B",
        "G → C#"
      ]
    }
  },
