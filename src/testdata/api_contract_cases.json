      "file",
      "format"
    ],
    "response": {
      "status": 200,
      "content_type": "text/plain; charset=utf-8",
      "headers": {
        "X-Transpose-From": "C",
        "X-Transpose-To": "D",
        "X-Transpose-Changes": "Am-%3EBm%2C%20C-%3ED%2C%20F-%3EG%2C%20G-%3EA",
        "Content-Disposition": "attachment; filename=hymn_D.txt"
      },
      "body_text": "D    A    Bm   G\nAmazing grace how sweet"
    },
    "ui": {
      "heading": "Transposed from C to D",
      "download": "hymn_D.txt",
      "preview": "D    A    Bm   G\nAmazing grace how sweet",
      "change_rows": [
        "A → B · Am",
        "C → D",
        "F → G",
        "G → A"
      ]
    }
  },
