  {
    "description": "binder merges several sheets into one PDF",
    "endpoint": "/binder",
    "trigger": "submit",
    "request": {
      "files": [
        {
          "field": "files",
          "filename": "a.docx",
          "content": "C G Am F",
          "raw": false
        },
        {
          "field": "files",
          "filename": "b.docx",
          "content": "Am F C G",
          "raw": false
        }
      ],
      "form": {
        "current_key": "C",
        "target_key": "D"
      }
    },
    "fields": [
      "current_key",
      "target_key",
      "files",
      "files"
    ],
    "response": {
      "status": 200,
      "content_type": "application/pdf",
      "headers": {
        "Content-Disposition": "attachment; filename=chord_binder_D.pdf"
      }
